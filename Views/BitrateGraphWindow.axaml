<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="using:ScottPlot.Avalonia"
        xmlns:vm="using:Nami.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Nami.Views.BitrateGraphWindow"
        x:DataType="vm:BitrateGraphViewModel"
        Title="Анализ битрейта видео"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#1C1C1E"
        Foreground="White"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Panel>
        <sp:AvaPlot Name="AvaPlot1" />

        <!-- Loading overlay -->
        <Border Background="#E61C1C1E" IsVisible="{Binding IsAnalyzing}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Анализ битрейта" FontSize="24" FontWeight="Bold" Foreground="#C4B5FD" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding VideoFilePath}" FontSize="12" Foreground="#A0A0A0" MaxWidth="600" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                
                <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ProgressBar Value="{Binding AnalysisProgress}" Minimum="0" Maximum="100" Width="300" Height="8"/>
            </StackPanel>
        </Border>

        <!-- Frame Preview Overlay -->
        <Border Name="PreviewBorder" Background="#E61C1C1E" CornerRadius="12" Padding="16" IsVisible="False" 
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#3A3A3C" BorderThickness="1">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Name="PreviewTitle" Text="Кадр на 00:00:00" FontSize="18" FontWeight="Bold" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="White" Click="OnClosePreviewClick" Padding="8,4" CornerRadius="15"/>
                </Grid>
                
                <TextBlock Name="PreviewBitrate" Text="Битрейт: 0 Mbps" FontSize="14" Foreground="#D0D0D0"/>
                
                <Border CornerRadius="8" ClipToBounds="True" Background="Black" Width="400" Height="225">
                    <Panel>
                        <Image Name="PreviewImage" Stretch="Uniform"/>
                        <TextBlock Name="PreviewLoadingText" Text="Загрузка кадра..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                    </Panel>
                </Border>
            </StackPanel>
        </Border>
    </Panel>
</Window>
