<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Nami.Views"
        xmlns:controls="using:Nami.Views.Controls"
        x:Class="Nami.Views.ScreenshotSelectionWindow"
        Title="Выбор скриншотов — Nami"
        Width="800" Height="580"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter,Segoe UI,sans-serif"
        CanResize="True"
        TransparencyLevelHint="Mica, AcrylicBlur"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        WindowDecorations="BorderOnly"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Caption buttons overlay -->
        <controls:TitleBarButtons HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="999"/>

        <Grid RowDefinitions="34, *" PointerPressed="OnTitleBarPointerPressed">

        <!-- Title Bar Area -->
        <Grid Grid.Row="0" Background="Transparent" Margin="0,0,138,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="Выбор скриншотов" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontFamily="Inter,Segoe UI,sans-serif"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillDefault}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12" Margin="14,0,14,14">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🖼️" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Выберите подходящие кадры" FontSize="18" FontWeight="Bold"
                                   Foreground="#C4B5FD" VerticalAlignment="Center"
                                   FontFamily="Inter,Segoe UI,sans-serif"/>
                    </StackPanel>
                    <TextBlock Text="Мы сгенерировали несколько скриншотов. Кликните, чтобы выбрать или отменить выбор."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondary}" TextWrapping="Wrap"
                               FontFamily="Inter,Segoe UI,sans-serif"/>
                </StackPanel>

                <!-- Grid of images -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundFillSecondary}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8" Padding="6">
                    <ListBox Name="ScreenshotsListBox" Background="Transparent" BorderThickness="0"
                             SelectionMode="Multiple,Toggle"
                             SelectionChanged="OnSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="200" ItemHeight="112" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="views:ScreenshotItem">
                                <Border CornerRadius="6" ClipToBounds="True" BorderThickness="2"
                                        BorderBrush="Transparent">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        <Border Background="#A0000000" IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
                                            <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#34D399"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,16,0,0">
                    <TextBlock Name="SelectionStatusTextBlock" Grid.Column="0"
                               Text="Выбрано: 0 скриншотов" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center"
                               FontFamily="Inter,Segoe UI,sans-serif"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="Отмена" Classes="DialogButton" Click="OnCancelClick"/>
                        <Button Name="ConfirmButton" Content="Подтвердить выбор" Classes="PrimaryDialogButton"
                                Click="OnConfirmClick" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
    </Panel>

</Window>
